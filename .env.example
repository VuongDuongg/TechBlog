# ==============================================================================
# TechBlog - PaaS Environment Variables Example
# Copy values below into Render / Railway (Backend) and Vercel (Frontend).
# NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (Render / Railway) - Required when SPRING_PROFILES_ACTIVE=prod
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL JDBC connection string (must include sslmode=require)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.ap-southeast-1.aws.neon.tech/techblog?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=replace-with-neon-password

# Base64-encoded 256-bit (or longer) secret key for HS256 JWT signing
# Example generator: openssl rand -base64 32
APP_JWT_SECRET=replace-with-base64-encoded-256bit-secret
APP_JWT_EXPIRATION_MS=86400000

# Comma-separated Vercel frontend origins allowed by CORS
APP_CORS_ALLOWED_ORIGINS=https://your-techblog.vercel.app

# Initial Root Admin credentials (strictly required in prod, 'admin123' is rejected)
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Cloudinary credentials for persistent image uploads
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_FOLDER=techblog

# Keep Swagger/OpenAPI disabled in production unless debugging
SPRINGDOC_ENABLED=false

# ------------------------------------------------------------------------------
# 2. FRONTEND (Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend-service.onrender.com/api
VITE_ROOT_ADMIN_EMAIL=admin@yourdomain.com
